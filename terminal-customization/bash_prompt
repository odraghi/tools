prompt_final_spacer() {
  last_spacer_with_icon='  '
  is_prompt_prompt_plugins_color_disabled || echo -n "$(font_reset)"
  is_prompt_icons_disabled || echo -n "$last_spacer_with_icon"
  is_prompt_prompt_plugins_color_disabled && is_prompt_icons_disabled && safe_zero_width_call echo -e "\r"
}

prompt_git() {
  current_branch=$(git branch --show-current 2>/dev/null)
  [ -z "${current_branch}" ] && return 1 # Not in a git direcory

  this_background_color=$(font_background_color $GIT_BG_COLOR)
  this_font_color=$(font_color $GIT_FG_COLOR)
  this_prompt_colors="${this_background_color}${this_font_color}"

  this_icon='git'
  this_icon_color=$(font_color $ICON_GIT_COLOR)

  # git@github.com:odraghi/tools.git
  origin=$(git remote get-url origin 2>/dev/null)

  echo $origin | grep -q "github.com:" && {
    this_icon='github'
    this_icon_color=$(font_color $ICON_GITHUB_COLOR)
  }

  echo $origin | grep -q "gitlab" && {
    this_icon='gitlab'
    this_icon_color=$(font_color $ICON_GITLAB_COLOR)
  }
  this_placeholder=$this_icon

  status_count=$(git status --porcelain 2> /dev/null| wc -l)
  [ $status_count -eq 0 ] && pending_change='' || {
    [ $status_count -gt 9 ] && status_count="9_plus"
    pending_change=" $(font_color $GIT_PENDING_CHANGE_COLOR)$(font_icon numeric_${status_count}_circle pending:${status_count})${this_font_color} "
  }
  this_icon_git_render=" ${this_icon_color}$(font_icon $this_icon $this_placeholder)"
  message="${this_icon_git_render}${this_prompt_colors}  $(font_icon 'branch')${pending_change} ${current_branch}"
  prompt_message_wrapped_in "circle_right" \
                            $GIT_FG_COLOR $GIT_BG_COLOR \
                            "$message" \
                            $CONTEXT_BAR_BG_COLOR $COLOR_DEFAULT
}

prompt_venv_info() {
  [ -z $VIRTUAL_ENV ] && return 1
  this_icon='python'
  this_placeholder='python:'
  this_decorator=${VENV_DECORATOR:-bubble}
  this_end_bg_color=$COLOR_DEFAULT
  git branch --show-current &>/dev/null && this_end_bg_color=$CONTEXT_BAR_BG_COLOR
  prompt_message_wrapped_in $this_decorator \
                            $PYTHON_FG_COLOR $PYTHON_BG_COLOR \
                            "$(font_icon $this_icon $this_placeholder) $(basename $VIRTUAL_ENV)" \
                            $PYTHON_BEGIN_FG_COLOR $this_end_bg_color
}

