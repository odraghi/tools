}

font_reset() {
  #tput sgr0
  safe_zero_width_call tput sgr0
}

tput_rainbow() {
  for B in {1..256}; do
    echo -e "\nBackground $B , Foregrounds:"
    for F in {1..256}; do
      printf "$(tput setaf $F)$(tput setab $B) %-5s $(tput sgr0)" $F
    done
  done
}

prompt_message_wrapped_in() {
  decorator=${1:-bubble}
  fg_color=${2:-256}
  bg_color=${3:-77}
  message=${4:-}
  begin_bg_color=${5:-256}
  end_bg_color=${6:-256}

  case $decorator in
  pointer_in)
    icon_begin="left_hard_divider_inversed"
    icon_end="right_hard_divider_inversed"
    ;;
  pointer_out)
    icon_begin="right_hard_divider"
    icon_end="left_hard_divider"
    ;;
  arrow_right)
    icon_begin="left_hard_divider_inversed"
    icon_end="left_hard_divider"
    ;;
  arrow_left)
    icon_begin="right_hard_divider"
    icon_end="right_hard_divider_inversed"
    ;;
  parallelogram_right)
    icon_begin="lower_right_triangle"
    icon_end="upper_left_triangle"
    ;;
  parallelogram_left)
    icon_begin="upper_right_triangle"
    icon_end="lower_left_triangle"
    ;;
  circle_right)
    icon_begin="full_block"
    icon_begin=" "
    icon_end="right_half_circle"
    ;;
  circle_left)
    icon_begin="left_half_circle"
    icon_end="full_block"
    icon_end=" "
    ;;
  bubble)
    icon_begin="left_half_circle"
    icon_end="right_half_circle"
    ;;
  *) # All or none
     icon_begin=''
     icon_end=''
     begin_border_color=''
     end_border_color=''
     ;;
  esac

  font_border_color="$(font_reset)$(font_color $bg_color)"

  [ -z $icon_begin ] || {
    begin_border_color="${font_border_color}$(font_background_color $begin_bg_color)"
    echo -e "${begin_border_color}$(font_icon $icon_begin)\c"
  }

  echo -e "$(font_color $fg_color)$(font_background_color $bg_color)${message}\c"

  [ -z $icon_end ] || {
    end_border_color="${font_border_color}$(font_background_color $end_bg_color)"
    echo -e "${end_border_color}$(font_icon $icon_end)\c"
  }

    echo -e "$(font_reset)\c"
}

tput_rainbow_font_for_background_color() {
  bg_color=${1:-236} # Default white
  nb_of_message_per_line=3
  count_message=0
  for FOREGROUND in {1..256} ; do
    ((count_message++))
    border_color="$(font_reset)$(font_color $bg_color)$(font_background_color $COLOR_DEFAULT)" 
    message="$(font_color $FOREGROUND)$(font_icon home)  $(font_icon github)  $(font_icon numeric_1_circle)  $FOREGROUND - background $bg_color"
    echo -e "${border_color}$(font_color $bg_color)$(font_background_color $bg_color) $message ${border_color}$(font_reset)   \c"
    [ $count_message -eq $nb_of_message_per_line ] && count_message=0 && echo -e "\n"
  done
  echo
}

tput_rainbow_background_for_font_color() {
  fg_color=${1:-231} # Default white
  nb_of_message_per_line=3
  count_message=0
  for BACK in {1..256} ; do
    ((count_message++))
    border_color="$(font_reset)$(font_color $BACK)$(font_background_color $COLOR_DEFAULT)" 
    message="$(font_icon home)  $(font_icon numeric_1_circle)  $fg_color - background $BACK"
    echo -e "${border_color}$(font_color $fg_color)$(font_background_color $BACK) $message ${border_color}$(font_reset)   \c"
    [ $count_message -eq $nb_of_message_per_line ] && count_message=0 && echo -e "\n"
  done
  echo
}


prompt_warning_size() {
  is_prompt_warning_size_disabled  && return
  WARN_FILESYSTEM_SIZE_PCENT=${WARN_FILESYSTEM_SIZE_PCENT:-80}
  size_pcent_used=$(df --output=pcent . | tail -1 | tr -d '[:space:]%')
  [ $size_pcent_used -lt $WARN_FILESYSTEM_SIZE_PCENT ] && return # Size is OK
  size_available=$(df -h --output=avail . | tail -1 | tr -d '[:space:]')
  this_filesystem=$(df --output=target . | tail -1 | tr -d '[:space:]')
  message="$(font_icon warning WARNING) Filesystem ${this_filesystem} ${size_available} free"
  prompt_message_wrapped_in "bubble" $COLOR_DEFAULT $COLOR_RED_196 "$message"
}

